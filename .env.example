OPENAI_API_KEY=
OPENAI_BASE_URL=
APP_NAME=Pipecat Voice Studio
PVS_ENVIRONMENT=development
PVS_BOT_BASE_URL=http://127.0.0.1:7860
PVS_DATABASE_PATH=data/pipecat_voice_studio.db
PVS_TIMEZONE=Asia/Calcutta
PVS_REALTIME_MODEL=gpt-realtime-2.1-mini
PVS_CASCADE_STT_MODEL=gpt-realtime-whisper
PVS_CASCADE_LLM_MODEL=gpt-5.6-luna
PVS_CASCADE_TTS_MODEL=gpt-4o-mini-tts
PVS_REALTIME_VOICE=marin

# Public HTTPS tunnel origin forwarding to the local gateway on port 8080.
PVS_PUBLIC_BASE_URL=
PVS_OUTBOUND_ALLOWLIST=

# Telephone providers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_HANDOFF_DESTINATION=
VONAGE_APPLICATION_ID=
VONAGE_API_KEY=
VONAGE_PRIVATE_KEY=
VONAGE_SIGNATURE_SECRET=
VONAGE_FROM_NUMBER=
VONAGE_HANDOFF_DESTINATION=

# Google Calendar service account and organization calendar.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
PVS_CALENDAR_SYNC_SECONDS=60

# CRM and avatar providers.
HUBSPOT_PRIVATE_APP_TOKEN=
SIMLI_API_KEY=
SIMLI_FACE_ID=

# Healthcare mode requires an operator-generated URL-safe base64 32-byte key.
PVS_HEALTHCARE_ENABLED=false
PVS_HEALTHCARE_DATA_KEY=
PVS_HEALTHCARE_APPROVED_SERVICES=openai
