flowchart LR
    browser["Browser<br/>React voice and avatar client"]
    phone["Telephone caller<br/>Twilio or Vonage"]
    studio["Streamlit studio"]
    api["FastAPI management API"]
    gateway["Telephony gateway<br/>signed callbacks"]
    worker["Pipecat worker<br/>validated pipeline runtime"]
    graphmod["Graph compiler<br/>closed schema"]
    models["OpenAI services<br/>Realtime or STT / LLM / TTS"]
    flows["Pipecat Flows<br/>appointments / business / healthcare"]
    providers["Google Calendar<br/>HubSpot / Simli"]
    sync["Calendar sync worker"]
    timeline["Semantic timeline observer"]
    db[("SQLite schema v2")]

    browser <-->|SmallWebRTC audio/video| worker
    phone <-->|provider media WebSocket| gateway
    gateway --> worker
    studio -->|definitions and records| db
    studio -->|start browser session| worker
    api -->|validated definitions| db
    worker --> graphmod
    worker <--> models
    worker --> flows
    flows <--> providers
    worker --> providers
    flows --> db
    worker --> timeline
    timeline --> db
    sync <--> providers
    sync --> db

    classDef focal fill:#fceee8,stroke:#eb6c36,color:#2d3142
    classDef store fill:#e9ebef,stroke:#4f5d75,color:#2d3142
    class worker,gateway focal
    class db store
