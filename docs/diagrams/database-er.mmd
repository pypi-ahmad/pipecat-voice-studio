erDiagram
    PIPELINE_DEFINITIONS ||--o{ SESSIONS : runs
    PIPELINE_DEFINITIONS ||--o{ EVAL_RUNS : evaluates
    PIPELINE_DEFINITIONS ||--o{ INTEGRATION_BINDINGS : binds
    SESSIONS ||--o{ SESSION_EVENTS : contains
    SESSIONS o|--o{ APPOINTMENTS : books
    SESSIONS o|--o{ CALLS : handles
    CALLS ||--o{ HANDOFFS : transfers
    SESSIONS o|--o{ CRM_RECORDS : produces
    SESSIONS ||--o| HEALTHCARE_CONSENTS : authorizes
    SESSIONS ||--o| HEALTHCARE_INTAKES : protects

    PIPELINE_DEFINITIONS {
        text id PK
        text name
        text mode
        text graph_json
        integer revision
        integer active
    }
    SESSIONS {
        text id PK
        text pipeline_id FK
        text status
        integer sensitive
        text started_at
        text ended_at
    }
    SESSION_EVENTS {
        integer id PK
        text session_id FK
        integer sequence
        text event_type
        text payload_json
    }
    APPOINTMENTS {
        text id PK
        text session_id FK
        text starts_at
        text status
        text provider
        text external_id
        text external_status
    }
    CALLS {
        text id PK
        text session_id FK
        text provider
        text provider_call_id
        text remote_last_four
        text status
    }
    HANDOFFS {
        text id PK
        text call_id FK
        text session_id FK
        text status
        text summary
    }
    CRM_RECORDS {
        text id PK
        text session_id FK
        text contact_id
        text deal_id
        integer score
        text status
    }
    HEALTHCARE_CONSENTS {
        text id PK
        text session_id FK
        text policy_version
        integer accepted
    }
    HEALTHCARE_INTAKES {
        text id PK
        text session_id FK
        blob ciphertext
        blob nonce
        text status
        integer escalated
    }
    EVAL_RUNS {
        text id PK
        text pipeline_id FK
        text scenario
        text status
        text result_json
    }
    INTEGRATION_BINDINGS {
        text provider PK
        text pipeline_id FK
    }
    CALENDAR_SYNC_STATE {
        text provider PK
        text sync_token
        text last_synced_at
        text last_error
    }
    AUDIT_EVENTS {
        integer id PK
        text action
        text resource_type
        text resource_id
        text outcome
    }
