flowchart LR
    media["Browser/provider media<br/>ephemeral frames"]
    pipeline["Pipecat processors<br/>Realtime or cascade"]
    tools["Governed Flow tools<br/>confirmation / consent"]
    providers["Calendar / CRM / telephone / avatar"]
    observer["SemanticTimelineObserver"]
    normal["Normal session events<br/>turns / tools / metrics"]
    health["Healthcare boundary<br/>no turn persistence"]
    cipher["AES-256-GCM<br/>session-bound intake"]
    store[("SQLite schema v2")]
    ui["Records / analytics<br/>metadata-only healthcare view"]

    media --> pipeline
    pipeline --> tools
    tools <--> providers
    pipeline --> observer
    observer --> normal
    normal --> store
    tools --> health
    health --> cipher
    cipher --> store
    store --> ui

    classDef focal fill:#fceee8,stroke:#eb6c36,color:#2d3142
    classDef storeStyle fill:#e9ebef,stroke:#4f5d75,color:#2d3142
    class observer,cipher focal
    class store storeStyle
